FROM mcr.microsoft.com/dotnet/sdk:10.0 AS build
WORKDIR /src
COPY . .
RUN dotnet restore src/Hosts/EDAN.Tensor.ApiHost/EDAN.Tensor.ApiHost.csproj
RUN dotnet publish src/Hosts/EDAN.Tensor.ApiHost/EDAN.Tensor.ApiHost.csproj -c Release -o /app/publish --no-restore

FROM mcr.microsoft.com/dotnet/aspnet:10.0 AS runtime
WORKDIR /app
ENV ASPNETCORE_URLS=http://+:8080
EXPOSE 8080
COPY --from=build /app/publish .
ENTRYPOINT ["dotnet", "EDAN.Tensor.ApiHost.dll"]
