<Window x:Class="EDAN.Tensor.Desktop.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:EDAN.Tensor.Desktop.ViewModels"
        xmlns:views="clr-namespace:EDAN.Tensor.Desktop.Views"
        Title="EDAN.Tensor" Width="1360" Height="820" MinWidth="1000" MinHeight="650">
    <Window.DataContext>
        <vm:MainWindowViewModel />
    </Window.DataContext>
    <Window.Resources>
        <DataTemplate DataType="{x:Type vm:TenantManagementViewModel}"><views:TenantManagementView /></DataTemplate>
        <DataTemplate DataType="{x:Type vm:OrganizationManagementViewModel}"><views:OrganizationManagementView /></DataTemplate>
        <DataTemplate DataType="{x:Type vm:ProjectManagementViewModel}"><views:ProjectManagementView /></DataTemplate>
        <DataTemplate DataType="{x:Type vm:UserInvitationManagementViewModel}"><views:UserInvitationManagementView /></DataTemplate>
        <DataTemplate DataType="{x:Type vm:MembershipManagementViewModel}"><views:MembershipManagementView /></DataTemplate>
        <DataTemplate DataType="{x:Type vm:AuthorizationPolicyManagementViewModel}"><views:AuthorizationPolicyManagementView /></DataTemplate>
        <DataTemplate DataType="{x:Type vm:AuthorizationAuditManagementViewModel}"><views:AuthorizationAuditManagementView /></DataTemplate>
        <DataTemplate DataType="{x:Type vm:StorageQuotaManagementViewModel}"><views:StorageQuotaManagementView /></DataTemplate>
        <DataTemplate DataType="{x:Type vm:DataSetManagementViewModel}"><views:DataSetManagementView /></DataTemplate>
        <DataTemplate DataType="{x:Type vm:DataSetSchemaManagementViewModel}"><views:DataSetSchemaManagementView /></DataTemplate>
        <DataTemplate DataType="{x:Type vm:DataSetStorageManagementViewModel}"><views:DataSetStorageManagementView /></DataTemplate>
        <DataTemplate DataType="{x:Type vm:DataSetValidationManagementViewModel}"><views:DataSetValidationManagementView /></DataTemplate>
        <DataTemplate DataType="{x:Type vm:WorkerTaskMonitoringViewModel}"><views:WorkerTaskMonitoringView /></DataTemplate>
        <DataTemplate DataType="{x:Type vm:DeadLetterQueueManagementViewModel}"><views:DeadLetterQueueManagementView /></DataTemplate>
        <DataTemplate DataType="{x:Type vm:ExternalDeliveryMonitoringViewModel}"><views:ExternalDeliveryMonitoringView /></DataTemplate>
    </Window.Resources>
    <Grid Background="{StaticResource WindowBackground}">
        <Grid.ColumnDefinitions><ColumnDefinition Width="280" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
        <Border Background="{StaticResource SidebarBackground}" Padding="20">
            <DockPanel>
                <StackPanel DockPanel.Dock="Top">
                    <TextBlock Text="EDAN.Tensor" Foreground="White" FontSize="24" FontWeight="SemiBold" />
                    <TextBlock Text="Universal Data Tensor Platform" Foreground="#AAB6C8" Margin="0,4,0,22" />
                    <TextBlock Text="화면 Registry" Foreground="#AAB6C8" FontSize="12" Margin="0,0,0,8" />
                    <TextBlock Text="API URL" Foreground="#AAB6C8" FontSize="11" />
                    <TextBox Text="{Binding Session.BaseAddress, UpdateSourceTrigger=PropertyChanged}" Margin="0,4,0,8" Padding="6" />
                    <TextBlock Text="Tenant ID (선택)" Foreground="#AAB6C8" FontSize="11" />
                    <TextBox Text="{Binding Session.TenantIdText, UpdateSourceTrigger=PropertyChanged}" Margin="0,4,0,8" Padding="6" />
                    <TextBlock Text="Bearer Token (선택)" Foreground="#AAB6C8" FontSize="11" />
                    <TextBox Text="{Binding Session.AccessToken, UpdateSourceTrigger=PropertyChanged}" Margin="0,4,0,8" Padding="6" />
                    <Button Content="API 연결" Command="{Binding ConnectCommand}" Margin="0,0,0,18" />
                </StackPanel>
                <ListBox ItemsSource="{Binding Screens}" SelectedItem="{Binding SelectedScreen}" Background="Transparent" BorderThickness="0" Foreground="White">
                    <ListBox.ItemContainerStyle>
                        <Style TargetType="ListBoxItem">
                            <Setter Property="Padding" Value="10,8" />
                            <Setter Property="Margin" Value="0,1" />
                            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                        </Style>
                    </ListBox.ItemContainerStyle>
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <StackPanel>
                                <TextBlock Text="{Binding ScreenId}" FontSize="11" Foreground="#8FA1BC" />
                                <TextBlock Text="{Binding Title}" FontSize="14" Margin="0,2,0,0" />
                            </StackPanel>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
                <TextBlock DockPanel.Dock="Bottom" Text="{Binding ConnectionStatus}" Foreground="#AAB6C8" TextWrapping="Wrap" Margin="0,16,0,0" />
            </DockPanel>
        </Border>
        <ContentControl Grid.Column="1" Content="{Binding SelectedScreen.ViewModel}" />
    </Grid>
</Window>
