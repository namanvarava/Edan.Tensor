<UserControl x:Class="EDAN.Tensor.Desktop.Views.RegistryScreenView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="Transparent">
    <Grid Margin="28">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <StackPanel>
            <TextBlock Text="{Binding ScreenId}" Foreground="{StaticResource AccentBrush}" FontSize="13" FontWeight="SemiBold" />
            <TextBlock Text="{Binding Title}" FontSize="30" FontWeight="SemiBold" Margin="0,5,0,0" />
            <TextBlock Text="{Binding Description}" Foreground="{StaticResource MutedBrush}" FontSize="15" Margin="0,7,0,0" />
        </StackPanel>
        <Border Grid.Row="1" Background="White" CornerRadius="8" Padding="14" Margin="0,24,0,16">
            <TextBlock Text="{Binding StatusMessage}" Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" />
        </Border>
        <Border Grid.Row="2" Background="White" CornerRadius="8" Padding="14" Margin="0,0,0,16">
            <StackPanel>
                <Grid Margin="0,0,0,8">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="170" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                    <TextBlock Text="검색어 (선택)" VerticalAlignment="Center" FontWeight="SemiBold" />
                    <TextBox Grid.Column="1" Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" />
                </Grid>
                <Grid Margin="0,0,0,8">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="170" /><ColumnDefinition Width="120" /><ColumnDefinition Width="170" /><ColumnDefinition Width="120" /></Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="페이지" VerticalAlignment="Center" FontWeight="SemiBold" />
                    <TextBox Grid.Column="1" Text="{Binding PageText, UpdateSourceTrigger=PropertyChanged}" />
                    <TextBlock Grid.Column="2" Text="페이지 크기" VerticalAlignment="Center" FontWeight="SemiBold" Margin="16,0,0,0" />
                    <TextBox Grid.Column="3" Text="{Binding PageSizeText, UpdateSourceTrigger=PropertyChanged}" />
                </Grid>
                <Grid>
                    <Grid.ColumnDefinitions><ColumnDefinition Width="170" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                    <TextBlock Text="대상 ID (선택)" VerticalAlignment="Center" FontWeight="SemiBold" />
                    <TextBox Grid.Column="1" Text="{Binding TargetIdText, UpdateSourceTrigger=PropertyChanged}"
                             ToolTip="DataSet, 검증 실행, Worker 작업, 외부 전달의 상세 조회에 사용합니다." />
                </Grid>
                <ItemsControl ItemsSource="{Binding TargetOptions}" Margin="170,8,0,0">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Button Content="{Binding Label}" Command="{Binding Command}" Margin="0,0,6,4" />
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
                <TextBlock Text="구조화된 Request DTO 입력" FontWeight="SemiBold" Margin="0,12,0,4" />
                <ItemsControl ItemsSource="{Binding Inputs}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Grid Margin="0,0,0,6">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="170" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                <TextBlock Text="{Binding Label}" VerticalAlignment="Center" FontWeight="SemiBold" />
                                <TextBox Grid.Column="1" Text="{Binding Text, UpdateSourceTrigger=PropertyChanged}" ToolTip="{Binding Placeholder}" />
                            </Grid>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
                <TextBlock Text="고급 Request DTO JSON (선택; 입력 시 구조화 입력보다 우선)" FontWeight="SemiBold" Margin="0,12,0,4" />
                <TextBox Text="{Binding CommandPayloadText, UpdateSourceTrigger=PropertyChanged}"
                         AcceptsReturn="True" MinHeight="62" TextWrapping="Wrap"
                         ToolTip="화면에 노출된 API Request DTO JSON을 입력합니다. 서버가 최종 검증합니다." />
                <Grid Margin="0,10,0,0">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="170" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                    <TextBlock Text="Idempotency/Replay 키" VerticalAlignment="Center" FontWeight="SemiBold" />
                    <TextBox Grid.Column="1" Text="{Binding IdempotencyKeyText, UpdateSourceTrigger=PropertyChanged}" />
                </Grid>
                <Grid Margin="0,10,0,0">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="170" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                    <TextBlock Text="최근 결과 ID" VerticalAlignment="Center" FontWeight="SemiBold" />
                    <TextBox Grid.Column="1" Text="{Binding LastResultIdText, Mode=OneWay}" IsReadOnly="True" />
                </Grid>
            </StackPanel>
        </Border>
        <ItemsControl Grid.Row="3" ItemsSource="{Binding Actions}" Margin="0,0,0,20">
            <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate><StackPanel Orientation="Horizontal" /></ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <Button Content="{Binding Label}" Command="{Binding Command}" Background="{StaticResource AccentBrush}" Foreground="White" BorderThickness="0" />
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>
        <Border Grid.Row="4" Background="White" CornerRadius="8" Padding="18">
            <ItemsControl ItemsSource="{Binding Fields}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Grid Margin="0,0,0,14">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="220" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                            <TextBlock Text="{Binding Label}" FontWeight="SemiBold" />
                            <TextBlock Grid.Column="1" Text="{Binding Value}" Foreground="{StaticResource MutedBrush}" TextWrapping="Wrap" />
                        </Grid>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </Border>
    </Grid>
</UserControl>
