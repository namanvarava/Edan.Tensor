{
  "ConnectionStrings": {
    "PlatformDatabase": "Data Source=App_Data/edan-tensor-platform.db;Cache=Shared",
    "DataSetDatabase": "Data Source=App_Data/edan-tensor-dataset.db;Cache=Shared",
    "DataSetContentDatabase": "Data Source=App_Data/edan-tensor-dataset-content.db;Cache=Shared"
  },
  "DataSetContent": {
    "MaxUploadBytes": 67108864,
    "Quota": {
      "TenantLimitBytes": null,
      "OrganizationLimitBytes": null,
      "ProjectLimitBytes": null,
      "DataSetLimitBytes": null,
      "WarningThresholdPercent": 80
    }
  },
  "AuthorizationAuditArchive": {
    "RootPath": "App_Data/AuthorizationAuditArchives"
  },
  "Database": {
    "ApplyMigrationsInDevelopment": true
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*"
}
