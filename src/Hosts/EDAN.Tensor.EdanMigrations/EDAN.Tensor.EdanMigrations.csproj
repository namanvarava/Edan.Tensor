<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <AssemblyName>EDAN.Tensor.EdanMigrations</AssemblyName>
    <RootNamespace>EDAN.Tensor.EdanMigrations</RootNamespace>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../../Edan/EDAN.Tensor.Edan.Infrastructure/EDAN.Tensor.Edan.Infrastructure.csproj" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <PackageReference Include="System.Security.Cryptography.Xml" PrivateAssets="all" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Sqlite" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.SqlServer" />
    <PackageReference Include="Npgsql.EntityFrameworkCore.PostgreSQL" />
    <PackageReference Include="Oracle.EntityFrameworkCore" />
  </ItemGroup>
  <ItemGroup>
    <Compile Include="EdanMigrationsMarker.cs" />
    <Compile Include="DesignTimeEdanDbContextFactory.cs" />
    <Compile Include="Migrations/**/*.cs" />
    <Compile Include="../../Edan/EDAN.Tensor.Edan.Infrastructure/Persistence/Migrations/*.cs"
             Link="Migrations/Sqlite/%(Filename)%(Extension)" />
  </ItemGroup>
</Project>
