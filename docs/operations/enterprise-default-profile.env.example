# EDAN.Tensor Enterprise default profile
# Copy outside the repository. Values ending in _REF are secret-store references.
ASPNETCORE_ENVIRONMENT=Production
Database__Provider=PostgreSQL

# Framework metadata: PostgreSQL HA or managed PostgreSQL.
ConnectionStrings__PlatformDatabase=secret://EDAN_FRAMEWORK_PLATFORM_CONNECTION
ConnectionStrings__WorkerDatabase=secret://EDAN_FRAMEWORK_WORKER_CONNECTION
ConnectionStrings__DataSetDatabase=secret://EDAN_FRAMEWORK_DATASET_CONNECTION
ConnectionStrings__DataSetContentDatabase=secret://EDAN_FRAMEWORK_DATASET_CONTENT_CONNECTION

# External identity provider; HTTPS is mandatory in production.
Authentication__Mode=External
Authentication__MetadataAddress=https://idp.example.invalid/realms/EDAN/.well-known/openid-configuration
Authentication__Issuer=https://idp.example.invalid/realms/EDAN
Authentication__Audience=edan-tensor-api
Authentication__RequireHttpsMetadata=true

# Inject from Secret Manager/HSM at runtime; do not add credentials here.
TenantDatabaseSecrets__Store=secret://EDAN_TENANT_DATABASE_SECRETS
License__Store=secret://EDAN_LICENSE_MATERIAL
Audit__Sink=siem://EDAN_AUDIT_SINK
Backup__Store=secret://EDAN_BACKUP_TARGET

# Enterprise defaults; override only through an approved capacity plan.
Operations__Profile=Enterprise
Operations__MinimumApiInstances=2
Operations__MinimumWorkerInstances=2
Operations__TargetRpoMinutes=15
Operations__TargetRtoMinutes=60
Operations__TargetConcurrentUsers=100
Operations__TargetRequestsPerSecond=25
