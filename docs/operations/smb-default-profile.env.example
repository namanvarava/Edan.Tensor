# EDAN.Tensor SME default profile
# Copy this file outside the repository and inject secrets from the OS-protected store.
ASPNETCORE_ENVIRONMENT=Production
Database__Provider=Sqlite

# EdanFramework internal metadata: SQLite on the local persistent volume.
ConnectionStrings__PlatformDatabase=Data Source=/app/App_Data/edan-platform.db;Cache=Shared
ConnectionStrings__WorkerDatabase=Data Source=/app/App_Data/edan-worker.db;Cache=Shared
ConnectionStrings__DataSetDatabase=Data Source=/app/App_Data/edan-dataset.db;Cache=Shared
ConnectionStrings__DataSetContentDatabase=Data Source=/app/App_Data/edan-dataset-content.db;Cache=Shared

# The SME installation still requires external authentication.
# Use the local Keycloak HTTPS endpoint or the customer's existing IdP.
Authentication__Mode=External
Authentication__MetadataAddress=https://idp.example.invalid/realms/EDAN-SME/.well-known/openid-configuration
Authentication__Issuer=https://idp.example.invalid/realms/EDAN-SME
Authentication__Audience=edan-tensor-api
Authentication__RequireHttpsMetadata=true

# TenantDatabaseSecrets and license material are injected at runtime from the
# OS-protected secret store; never add them to this file.
